<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== 权限与应用可见性声明区 ==================== -->

    <!-- 1. GPS 精确定位与粗略定位权限：用于计算实时移动速度，判断是否在骑自行车（>8km/h） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 2. 后台定位权限：息屏或切换到滴滴后，依然能获取速度 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 3. 硬件计步与身体动作传感器：直接调用手机协处理器，识别停下车后的迈步动作（零耗电） -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />

    <!-- 4. 前台服务权限与定位类型：Android 10~14+ 规范，确保监测服务不会被小米系统误判杀后台 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 5. 通知与全屏强提醒权限：锁屏或下车时弹出高优先级横幅和响铃 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- 6. 强力震动与唤醒屏幕：到达目的地时触发连续强震动，提醒锁车 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />

    <!-- 7. 请求忽略电池优化：引导小米 HyperOS/MIUI 系统不限制后台活动 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 8. 使用情况访问权限：用于在后台感知用户打开滴滴 App 并自动唤醒锁车助手 -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 9. 查询设备所有应用权限（Android 11+ 查询滴滴 App） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 10. Android 11+ 软件包可见性声明：显式声明滴滴及青桔相关包名与 Scheme -->
    <queries>
        <!-- 滴滴（原滴滴出行，改名后包名仍为 com.sdu.didi.psnger） -->
        <package android:name="com.sdu.didi.psnger" />
        <!-- 滴滴青桔单车独立版 / 滴滴单车 -->
        <package android:name="com.didi.echo" />
        <!-- 滴滴其他定制渠道包 -->
        <package android:name="com.didipinche.booking" />
        <package android:name="com.didiglobal.passenger" />
        <!-- 滴滴官方唤起 Scheme -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="didipasnger" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="didi" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BikeLocker"
        tools:targetApi="31">

        <!-- 主界面 Activity（允许锁屏直接唤醒展示全屏警报弹窗） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 核心前台常驻服务：负责后台 GPS 测速与步频监听 -->
        <service
            android:name=".service.RideMonitorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- 滴滴 App 前台打开自动感应常驻后台服务 -->
        <service
            android:name=".service.DidiAutoDetectService"
            android:enabled="true"
            android:exported="false" />

        <!-- 广播接收器：处理通知栏上的快捷按钮点击（如“我已锁车”、“打开滴滴”） -->
        <receiver
            android:name=".receiver.NotificationActionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.campus.bikelocker.ACTION_LOCK_CONFIRMED" />
                <action android:name="com.campus.bikelocker.ACTION_OPEN_DIDI" />
                <action android:name="com.campus.bikelocker.ACTION_DISMISS_ALERT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
